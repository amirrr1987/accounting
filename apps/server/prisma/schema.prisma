generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum AccountNature {
  DEBIT
  CREDIT
}

enum AccountLevel {
  GROUP
  TOTAL
  SUBTOTAL
  DETAIL
}

enum PartyKind {
  CUSTOMER
  SUPPLIER
}

enum InvoiceKind {
  SALE
  PURCHASE
  SALE_RETURN
  PURCHASE_RETURN
}

enum VoucherKind {
  GENERAL
  RECEIPT
  PAYMENT
  INVOICE
  REVERSAL
}

enum UserRole {
  ADMIN
  ACCOUNTANT
  VIEWER
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  EXPORT
  RESTORE
}

enum ProductPricingMode {
  FIXED
  AT_INVOICE
}

enum WeightAdjustmentKind {
  SHORTAGE
  SURPLUS
}

enum PaymentMethod {
  CASH
  CHECK_PAYABLE
  CHECK_RECEIVABLE
}

enum CheckKind {
  RECEIVABLE
  PAYABLE
}

enum CheckStatus {
  IN_PORTFOLIO
  DEPOSITED
  CLEARED
  RETURNED
  ENDORSED
  PAID
}

enum BusinessType {
  SHOP
  WORKSHOP
  WAREHOUSE
  FACTORY
  COMPANY
  OTHER
}

enum ExpensePayFrom {
  CASH
  BANK
}

model FiscalYear {
  id                  String   @id @default(uuid())
  title               String   @unique
  startJalali         String
  endJalali           String
  isClosed            Boolean  @default(false)
  isActive            Boolean  @default(false)
  /// قفل تا این تاریخ — اسناد قبل/مساوی قابل ثبت نیست
  closedThroughJalali String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("fiscal_years")
}

model Account {
  id        String        @id @default(uuid())
  code      String        @unique
  name      String
  type      AccountType
  nature    AccountNature
  level     AccountLevel
  parentId  String?
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  parent       Account?      @relation("AccountTree", fields: [parentId], references: [id], onDelete: Restrict)
  children     Account[]     @relation("AccountTree")
  voucherLines VoucherLine[]
  bankAccounts BankAccount[]
  partnerCapitalCoa BusinessPartner[] @relation("PartnerCapitalCoa")
  partnerDrawingCoa BusinessPartner[] @relation("PartnerDrawingCoa")

  @@index([parentId])
  @@index([name])
  @@map("accounts")
}

model Voucher {
  id           String      @id @default(uuid())
  number       String      @unique
  kind         VoucherKind @default(GENERAL)
  date         DateTime    @db.Date
  description  String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  /// برای برگشت فاکتور حذف‌شده
  reversedOfId String?     @unique
  reversedOf   Voucher?    @relation("VoucherReversal", fields: [reversedOfId], references: [id])
  reversal     Voucher?    @relation("VoucherReversal")
  paymentMethod PaymentMethod?
  bankAccountId String?
  bankAccount   BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)

  lines            VoucherLine[]
  invoice          Invoice?
  weightAdjustment WeightAdjustment?
  check            Check?       @relation("CheckReceiptVoucher")
  checkEvents      CheckEvent[]
  expense          Expense?
  ownerDrawing     OwnerDrawing?
  partnerDrawing   PartnerDrawing?

  @@index([date])
  @@index([kind])
  @@map("vouchers")
}

model VoucherLine {
  id          String  @id @default(uuid())
  voucherId   String
  accountId   String
  partyId     String?
  description String  @default("")
  debit       BigInt  @default(0)
  credit      BigInt  @default(0)
  lineOrder   Int

  voucher Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)
  party   Party?  @relation(fields: [partyId], references: [id], onDelete: Restrict)

  @@index([voucherId])
  @@index([accountId])
  @@index([partyId])
  @@map("voucher_lines")
}

model VoucherSequence {
  id    Int @id @default(1)
  value Int @default(0)

  @@map("voucher_sequences")
}

model Party {
  id             String    @id @default(uuid())
  kind           PartyKind
  name           String
  phone          String?
  nationalId     String?
  /// نرخ پورسانت پیش‌فرض (۰ تا ۱)
  commissionRate Float?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  invoices     Invoice[]
  voucherLines VoucherLine[]
  checks       Check[]
  expenses     Expense[]

  @@index([kind])
  @@index([name])
  @@map("parties")
}

model UnitOfMeasure {
  id               String   @id @default(uuid())
  code             String   @unique
  nameFa           String
  baseUnitId       String?
  conversionFactor Float    @default(1)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  baseUnit     UnitOfMeasure?  @relation("UnitConversion", fields: [baseUnitId], references: [id], onDelete: Restrict)
  derivedUnits UnitOfMeasure[] @relation("UnitConversion")
  products     Product[]
  invoiceLines InvoiceLine[]

  @@map("units_of_measure")
}

model Product {
  id            String             @id @default(uuid())
  sku           String             @unique
  name          String
  unitPrice     BigInt
  costPrice     BigInt             @default(0)
  stockQty      Int                @default(0)
  vatRate       Float              @default(0.09)
  pricingMode   ProductPricingMode @default(AT_INVOICE)
  defaultUnitId String?
  isActive      Boolean            @default(true)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  defaultUnit        UnitOfMeasure?     @relation(fields: [defaultUnitId], references: [id], onDelete: SetNull)
  invoiceLines       InvoiceLine[]
  weightAdjustments  WeightAdjustment[]

  @@map("products")
}

model Invoice {
  id               String      @id @default(uuid())
  number           String      @unique
  kind             InvoiceKind
  partyId          String
  date             DateTime    @db.Date
  description      String      @default("")
  subtotal         BigInt
  vatAmount        BigInt
  headerDiscount   BigInt      @default(0)
  total            BigInt
  commissionAmount BigInt      @default(0)
  commissionRate   Float?
  returnedOfId     String?
  returnReason     String?
  voucherId        String?     @unique
  deletedAt        DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  party      Party         @relation(fields: [partyId], references: [id], onDelete: Restrict)
  voucher    Voucher?      @relation(fields: [voucherId], references: [id], onDelete: Restrict)
  returnedOf Invoice?      @relation("InvoiceReturn", fields: [returnedOfId], references: [id], onDelete: Restrict)
  returns    Invoice[]     @relation("InvoiceReturn")
  lines      InvoiceLine[]
  weightAdjustments WeightAdjustment[] @relation("SourceInvoice")

  @@index([partyId])
  @@index([date])
  @@index([deletedAt])
  @@index([returnedOfId])
  @@map("invoices")
}

model InvoiceLine {
  id             String  @id @default(uuid())
  invoiceId      String
  productId      String
  quantity       Int
  unitPrice          BigInt
  catalogUnitPrice   BigInt?
  vatRate            Float
  discountAmount BigInt  @default(0)
  lineNet        BigInt
  lineVat        BigInt
  lineTotal      BigInt
  lineOrder      Int
  sourceLineId   String?
  unitId         String?

  invoice    Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product    Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  sourceLine InvoiceLine?   @relation("LineReturn", fields: [sourceLineId], references: [id], onDelete: Restrict)
  returnLines InvoiceLine[] @relation("LineReturn")
  unit       UnitOfMeasure? @relation(fields: [unitId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([sourceLineId])
  @@map("invoice_lines")
}

model InvoiceSequence {
  id    Int @id @default(1)
  value Int @default(0)

  @@map("invoice_sequences")
}

model WeightAdjustment {
  id              String               @id @default(uuid())
  productId       String
  kind            WeightAdjustmentKind
  quantity        Int
  reason          String
  date            DateTime             @db.Date
  costAmount      BigInt
  sourceInvoiceId String?
  voucherId       String?              @unique
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  product       Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  sourceInvoice Invoice? @relation("SourceInvoice", fields: [sourceInvoiceId], references: [id], onDelete: SetNull)
  voucher       Voucher? @relation(fields: [voucherId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([date])
  @@map("weight_adjustments")
}

model BankAccount {
  id            String   @id @default(uuid())
  name          String
  bankName      String
  accountNumber String?
  sheba         String?
  coaAccountId  String   @unique
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  coaAccount Account  @relation(fields: [coaAccountId], references: [id], onDelete: Restrict)
  vouchers   Voucher[]
  checks     Check[]

  @@map("bank_accounts")
}

model Check {
  id                 String      @id @default(uuid())
  kind               CheckKind
  sayyadNumber       String      @unique
  issueDate          DateTime    @db.Date
  dueDate            DateTime    @db.Date
  amount             BigInt
  partyId            String
  drawerNationalId   String
  drawerMobile       String
  bankName           String
  branchCode         String?
  accountNumber      String?
  status             CheckStatus @default(IN_PORTFOLIO)
  receiptVoucherId   String?     @unique
  bankAccountId      String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  party           Party        @relation(fields: [partyId], references: [id], onDelete: Restrict)
  receiptVoucher  Voucher?     @relation("CheckReceiptVoucher", fields: [receiptVoucherId], references: [id], onDelete: SetNull)
  bankAccount     BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  events          CheckEvent[]

  @@index([partyId])
  @@index([status])
  @@index([dueDate])
  @@map("checks")
}

model CheckEvent {
  id        String      @id @default(uuid())
  checkId   String
  status    CheckStatus
  date      DateTime    @db.Date
  note      String?
  voucherId String?     @unique
  createdAt DateTime    @default(now())

  check   Check    @relation(fields: [checkId], references: [id], onDelete: Cascade)
  voucher Voucher? @relation(fields: [voucherId], references: [id], onDelete: SetNull)

  @@index([checkId])
  @@map("check_events")
}

model BusinessSettings {
  id                 String       @id @default("default")
  businessName       String       @default("کسب‌وکار من")
  businessType       BusinessType @default(SHOP)
  businessTypeCustom String?
  legalName          String?
  nationalId         String?
  economicCode       String?
  phone              String?
  mobile             String?
  address            String?
  city               String?
  postalCode         String?
  description        String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@map("business_settings")
}

model ExpenseCategory {
  id             String   @id @default(uuid())
  code           String   @unique
  nameFa         String
  coaAccountCode String
  isSystem       Boolean  @default(true)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  expenses Expense[]

  @@map("expense_categories")
}

model Expense {
  id            String         @id @default(uuid())
  categoryId    String
  date          DateTime       @db.Date
  amount        BigInt
  description   String         @default("")
  payFrom       ExpensePayFrom @default(CASH)
  cashAccountId String?
  bankAccountId String?
  partyId       String?
  voucherId     String?        @unique
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  category ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  party    Party?          @relation(fields: [partyId], references: [id], onDelete: SetNull)
  voucher  Voucher?        @relation(fields: [voucherId], references: [id], onDelete: SetNull)

  @@index([categoryId])
  @@index([date])
  @@map("expenses")
}

model Owner {
  id         String   @id @default(uuid())
  name       String
  mobile     String?
  nationalId String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  drawings OwnerDrawing[]

  @@map("owners")
}

model OwnerDrawing {
  id            String         @id @default(uuid())
  ownerId       String
  date          DateTime       @db.Date
  amount        BigInt
  description   String         @default("")
  payFrom       ExpensePayFrom @default(CASH)
  cashAccountId String?
  bankAccountId String?
  voucherId     String?        @unique
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  owner   Owner    @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  voucher Voucher? @relation(fields: [voucherId], references: [id], onDelete: SetNull)

  @@index([ownerId])
  @@index([date])
  @@map("owner_drawings")
}

model BusinessPartner {
  id                  String   @id @default(uuid())
  name                String
  mobile              String?
  nationalId          String?
  sharePercent        Float
  coaCapitalAccountId String   @unique
  coaDrawingAccountId String   @unique
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  coaCapitalAccount Account          @relation("PartnerCapitalCoa", fields: [coaCapitalAccountId], references: [id], onDelete: Restrict)
  coaDrawingAccount Account          @relation("PartnerDrawingCoa", fields: [coaDrawingAccountId], references: [id], onDelete: Restrict)
  drawings          PartnerDrawing[]

  @@map("business_partners")
}

model PartnerDrawing {
  id            String         @id @default(uuid())
  partnerId     String
  date          DateTime       @db.Date
  amount        BigInt
  description   String         @default("")
  payFrom       ExpensePayFrom @default(CASH)
  cashAccountId String?
  bankAccountId String?
  voucherId     String?        @unique
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  partner BusinessPartner @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  voucher Voucher?        @relation(fields: [voucherId], references: [id], onDelete: SetNull)

  @@index([partnerId])
  @@index([date])
  @@map("partner_drawings")
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  role         UserRole @default(ACCOUNTANT)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  auditLogs AuditLog[]

  @@map("users")
}

model AuditLog {
  id        String      @id @default(uuid())
  userId    String?
  username  String
  action    AuditAction
  entity    String
  entityId  String?
  detail    String?
  createdAt DateTime    @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@index([entity])
  @@map("audit_logs")
}
